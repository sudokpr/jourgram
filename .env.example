# Life Data Lake Configuration
#
# You can configure via config.yaml OR environment variables (recommended)
# Environment variables use __ as nested delimiter (e.g., TELEGRAM__API_ID)

# Telegram Configuration
TELEGRAM__API_ID=12345
TELEGRAM__API_HASH=your_api_hash_here
TELEGRAM__PHONE=+1234567890
TELEGRAM__SESSION_NAME=life-data-lake

# The chat ID of your LifeOS supergroup (numeric ID, starts with -100)
# To find: forward a message from your group to @userinfobot
TELEGRAM__CHAT_ID=-1001234567890

# Topic IDs - get these from Telegram when you create topics
# They appear in the topic link or via API when listing messages
TELEGRAM__TOPICS__JOURNAL=1
TELEGRAM__TOPICS__LEARNING=2
TELEGRAM__TOPICS__IDEAS=3
TELEGRAM__TOPICS__EXPENSES=4
TELEGRAM__TOPICS__LINKS=5
TELEGRAM__TOPICS__QUICK_DUMP=6

# Storage
DATA_DIR=./data
MEDIA_DIR=./data/media
RAW_JSON_DIR=./data/raw-json

# Gemini Configuration
GEMINI__API_KEY=your_gemini_api_key_here
GEMINI__MODEL_DAILY=gemini-2.5-flash
GEMINI__MODEL_DEEP=gemini-2.5-pro

# Processing
MAX_WORKERS=4
BATCH_SIZE=50

# Scheduler (24-hour format)
DAILY_SUMMARY_HOUR=20
DAILY_SUMMARY_MINUTE=0