[Unit]
Description=Life Data Lake Daily Summary
After=network.target

[Service]
Type=oneshot
User=kp
WorkingDirectory=/home/kp/workspace/projects/jourgram
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/kp/workspace/projects/jourgram/venv/bin/python -m app.main summarize

[Install]
WantedBy=multi-user.target